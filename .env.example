# Opptra Discount Engine — Environment Configuration
# Copy this file to .env and configure your credentials.
# Do NOT commit .env to version control.

# Server port (default 3001)
PORT=3001

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model name (defaults to gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional: Production CORS allowed origins (comma-separated whitelist)
# If unset in production, cross-origin browser requests are rejected by default (default-deny)
# FRONTEND_ORIGIN=https://your-domain.vercel.app,http://localhost:3001

